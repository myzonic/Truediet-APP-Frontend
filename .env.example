# True Diet frontend environment
#
# Copy this file to `.env` and adjust for your environment. `.env` is
# gitignored — never commit real values.
#
# EXPO_PUBLIC_* values are inlined into the client bundle at build time, so
# anything here is visible to anyone who uses the app. Never put secrets,
# API keys or database credentials in this file.

# Base URL of the True Diet backend API (no trailing slash).
#
# Production  : https://api.true-diet.com
# Local dev   : http://localhost:3000            (Metro/web)
# Android emu : http://10.0.2.2:3000             (host machine loopback)
# iOS sim     : http://localhost:3000
# Physical phone on same Wi-Fi : http://<your-LAN-IP>:3000
#
# The app falls back to http://localhost:3000 when this is unset.
EXPO_PUBLIC_AUTH_URL=https://api.true-diet.com

# EAS project id, required for remote push notifications (expo-notifications).
# Get it with `npx eas init`, or from https://expo.dev/accounts/<account>/projects/<project>.
# Without it, in-app push registration returns a "needs project id" error.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional override for the sherpa-onnx speech model WASM assets.
# Leave empty to use the default jsDelivr CDN.
EXPO_PUBLIC_SHERPA_WASM_BASE=
